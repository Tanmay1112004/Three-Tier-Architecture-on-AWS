#!/bin/bash
# Application release: ${app_release}
set -euo pipefail
dnf install -y nginx git
git clone --depth 1 '${app_repo_url}' /tmp/app
install -d /usr/share/nginx/html
cp -a /tmp/app/frontend/. /usr/share/nginx/html/
rm -f /etc/nginx/conf.d/default.conf
cat > /etc/nginx/conf.d/three-tier.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://${backend_dns};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
NGINX
rm -f /etc/nginx/conf.d/php-fpm.conf
systemctl enable --now nginx
